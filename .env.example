# ================================================================
# MEDI-TREND AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ================================================================

# --- 1. AI Engine & LLM Providers (Backend) ---
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=openrouter,grok

# Google Gemini AI (Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OpenRouter AI (Fallback 1)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o

# xAI Grok (Fallback 2)
GROK_API_KEY=your_grok_api_key_here
XAI_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-beta

# --- 2. Database & Supabase (Backend & Frontend) ---
# Supabase PostgreSQL Database URI (Backend)
# When set, the backend uses PostgreSQL (production/Vercel).
# When unset, the backend falls back to local SQLite (development).
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Set to '1' on Vercel to store SQLite in /tmp (fallback if DATABASE_URL is unset).
# Ignored when DATABASE_URL is set.
VERCEL=0

# Supabase Storage (Backend only — server-side credentials)
# Required for persistent PDF uploads on Vercel. Never expose these to the frontend.
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_[YOUR_KEY]
SUPABASE_STORAGE_BUCKET=medical-reports

# Supabase Client Configuration (Frontend)
VITE_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR_KEY]

# --- 3. Frontend API Base URL (Frontend) ---
# Leave unset for local development; Vite proxies /api to http://127.0.0.1:8000.
# For separately hosted frontend/backend deployments, set the backend origin.
# Example: VITE_API_URL=https://your-backend-domain.vercel.app
VITE_API_URL=https://your-backend-domain.example

# Comma-separated browser origins permitted by FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
